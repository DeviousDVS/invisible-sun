<div class="{{cssClass}} flexcol" autocomplete="off">
  {{> "systems/invisible-sun/templates/partials/header-bar.hbs"}}

  <nav class="sheet-tabs tabs" data-group="primary">
    {{#each tabs as |tab|}}
      <a class="item {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">{{localize tab.label}}</a>
    {{/each}}
  </nav>

  <section class="sheet-body">
    
    {{!-- Overview Tab --}}
    <div class="tab overview {{tabs.overview.cssClass}}" data-group="primary" data-tab="overview">
      <div class="character-sentence-banner">
        <span>{{{characterSentenceHTML}}}</span>
      </div>
      
      {{> "systems/invisible-sun/templates/partials/stat-pool.hbs"}}

      {{!-- Skills sit under the pools: both feed a venture, and a player
            deciding a roll wants to see them together. --}}
      {{> "systems/invisible-sun/templates/partials/skill-list.hbs"}}

      <div class="overview-grid mt-4">
        <div class="overview-health">
          {{!-- Titled like the panel beside it: the two are a pair and one of
                them saying what it is while the other did not read as an
                oversight rather than a choice. --}}
          <h3>{{localize "ISUN.DefenceHealth"}}</h3>
          {{> "systems/invisible-sun/templates/partials/wound-tracker.hbs"}}
        </div>
        
        <div class="overview-advancement">
          <h3>{{localize "ISUN.Advancement"}}</h3>

          {{!-- Degree sits with advancement: it is bought with Crux, which is
                the line directly under it.

                Ordered as it is said rather than as a form is usually laid
                out: "2nd Degree, Crafter" is one fact in one line, where a
                caption over a bare number made the reader assemble it. The
                comma rides on the label so the flex gap cannot open a space in
                front of it, and goes when there is no title to follow it.

                The number is the character's; the name for it belongs to the
                order and is read from there. --}}
          <div class="degree-picker">
            <select name="system.meta.orderDegree">
              <option value="0" {{#if (eq system.meta.orderDegree 0)}}selected{{/if}}>—</option>
              {{#each degreeLadder as |d|}}
                <option value="{{d.degree}}" {{#if d.current}}selected{{/if}}>{{ordinal d.degree}}</option>
              {{/each}}
            </select>
            <label>{{localize "ISUN.OrderDegree"}}{{#if orderDegreeTitle}},{{/if}}</label>
            <span class="degree-title">{{orderDegreeTitle}}</span>
            {{!-- What the next rung costs, at the far end of the row that sells
                  it. Quieter than the degree itself: it is what a player is
                  saving towards rather than what they have, and the Crux they
                  hold is already stated in full a line below. Absent at the top
                  of the ladder, and for a character with no order. --}}
            {{#if nextDegree}}
              <span class="degree-next" data-tooltip="{{localize 'ISUN.NextDegreeHint'}}">
                {{localize "ISUN.NextDegree"}} {{nextDegree.cost}}
                <i class="fa-solid fa-star"></i>
              </span>
            {{/if}}
          </div>

          {{!-- Crux is not one of the four below. It is what a Joy and a
                Despair are worth together, and it comes into existence only
                when something is bought — so this is a rate, not a holding.
                Uneven pools are worth saying out loud: knowing you have the Joy
                but not the Despair is what tells a player which path to walk
                next. --}}
          <div class="crux-readout{{#unless crux}} empty{{/unless}}"
               data-tooltip="{{localize 'ISUN.CruxHint'}}">
            <span class="crux-label">{{localize "ISUN.CruxAvailable"}}</span>
            <span class="crux-value">{{crux}}</span>
            <i class="fa-solid fa-star"></i>
            {{#if cruxShortOf}}
              <span class="crux-limit">{{localize "ISUN.CruxShortOf"}} {{cruxShortOf}}</span>
            {{/if}}
          </div>

          {{!-- Four things that are earned and kept: name, value, icon, in
                fixed columns so the numbers form a line the eye can run down.
                Each says where it comes from on hover, because a sun and a moon
                side by side do not tell anyone which is Joy. The adjust controls
                reserve their space whether shown or not, or the icons would
                jump on hover.

                Named "advancement-" and not "adv-" on purpose. Ad blockers hide
                .adv-label outright — it is the conventional class for the
                "Advertisement" disclosure a publisher is required to show — so
                the labels rendered as nothing at all in Vivaldi, which ships
                with blocking on. uBlock, Brave and AdGuard carry the same
                lists. Do not shorten these back. --}}
          <div class="advancement-bar">
            {{#each advancement as |a|}}
              <div class="advancement-row {{a.key}}" data-tooltip="{{localize a.hint}}">
                <span class="advancement-name">{{localize a.label}}</span>
                {{!-- GM only. Joy and Despair are awarded, and Acumen is what
                      an arc beat pays out — none of it is a player's to set. A
                      player still sees every number, which is the part that
                      matters at the table.

                      @root.isGM, not isGM: inside {{#each}} the context is the
                      row, so a bare lookup finds nothing on it and the controls
                      silently never render. --}}
                {{#if @root.isGM}}
                  <span class="advancement-adjust">
                    <a data-action="advancement-adjust" data-key="{{a.key}}" data-delta="1"
                       data-tooltip="{{localize 'ISUN.AdvGain'}}">+</a>
                    <a data-action="advancement-adjust" data-key="{{a.key}}" data-delta="-1"
                       data-tooltip="{{localize 'ISUN.AdvSpend'}}">−</a>
                  </span>
                {{/if}}
                <span class="advancement-value">{{a.value}}</span>
                <i class="fa-solid {{a.icon}}"></i>
              </div>
            {{/each}}
          </div>
        </div>
      </div>
    </div>


    {{!-- Magic Tab --}}
    <div class="tab magic {{tabs.magic.cssClass}}" data-group="primary" data-tab="magic">
      {{> "systems/invisible-sun/templates/partials/order.hbs"}}
      {{> "systems/invisible-sun/templates/partials/practices.hbs"}}
      {{> "systems/invisible-sun/templates/partials/secrets.hbs"}}
    </div>



    {{!-- Connections Tab --}}
    <div class="tab connections {{tabs.connections.cssClass}}" data-group="primary" data-tab="connections">
      {{> "systems/invisible-sun/templates/partials/connections.hbs"}}
    </div>

    {{!-- Arcs Tab --}}
    <div class="tab arcs {{tabs.arcs.cssClass}}" data-group="primary" data-tab="arcs">
      {{> "systems/invisible-sun/templates/partials/character-arc-tracker.hbs"}}
    </div>

    {{!-- Inventory Tab --}}
    <div class="tab inventory {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">
      {{> "systems/invisible-sun/templates/partials/inventory-list.hbs"}}
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography {{tabs.biography.cssClass}}" data-group="primary" data-tab="biography">
      {{> "systems/invisible-sun/templates/partials/narrative.hbs"}}
    </div>

  </section>
</div>
