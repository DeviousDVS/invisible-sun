<div class="pool-row" data-pool="{{poolName}}">
  <div class="pool-label">
    {{localize label}}
    {{#if pool.scourgeTotal}}
      <span class="scourge-mark" title="{{localize 'ISUN.ScourgeHint'}}">−{{pool.scourgeTotal}}</span>
    {{/if}}
  </div>
  
  {{!-- Held bene first, then the empty slots, so a pool drains from the right
        as it is spent rather than filling from it. A readout only: bene are
        spent in the venture dialog, against the action they are paying for. --}}
  <div class="pool-pips">
    {{#times pool.value}}
      <span class="{{#if pipClass}}{{pipClass}}{{else}}bene-pip{{/if}} full"></span>
    {{/times}}
    {{#times (poolRemaining pool)}}
      <span class="{{#if pipClass}}{{pipClass}}{{else}}bene-pip{{/if}} empty"></span>
    {{/times}}
  </div>
  
  {{!-- Vexes sit with the bene, which is where the book puts them: "use the vex
        and scourge counters right in the appropriate pools on the stat pool
        sheet, just like bene" (The Key, p2294). They are not pool slots though
        — a vex does not use up a bene's place — so they read as their own run
        of red beside the track rather than inside it.

        Only a GM places one. "The GM decides when you spend a vex", and a vex
        arrives from a kindled item or a piece of weird magic rather than from
        anything the player does, so a player has no occasion to add one. They
        still see any they are carrying. --}}
  {{#if @root.isGM}}
    <span class="vex-group gm" title="{{localize 'ISUN.VexHint'}}">
      {{#times pool.vex}}
        <span class="vex-pip" data-action="remove-vex" data-pool="{{poolName}}"
              data-stat="{{statKey}}" title="{{localize 'ISUN.VexRemove'}}"></span>
      {{/times}}
      <a class="vex-add" data-action="add-vex" data-pool="{{poolName}}"
         data-stat="{{statKey}}" title="{{localize 'ISUN.VexAdd'}}">+</a>
    </span>
  {{else if pool.vex}}
    <span class="vex-group" title="{{localize 'ISUN.VexHint'}}">
      {{#times pool.vex}}<span class="vex-pip"></span>{{/times}}
    </span>
  {{/if}}

  {{!-- Placing points. Minus shows whenever a pool has something to give
        back, so a player can always reallocate; plus only while points remain
        to place, so the budget cannot be overspent. --}}
  {{#if showAllocation}}
    <div class="pool-alloc">
      <a class="alloc-btn minus{{#unless pool.max}} disabled{{/unless}}"
         data-action="alloc-pool" data-delta="-1" data-pool="{{poolName}}"
         data-stat="{{statKey}}" data-tooltip="{{localize 'ISUN.AllocTakeBack'}}">−</a>
      <a class="alloc-btn plus{{#unless (lookup canPlace statKey)}} disabled{{/unless}}"
         data-action="alloc-pool" data-delta="1" data-pool="{{poolName}}"
         data-stat="{{statKey}}" data-tooltip="{{localize 'ISUN.AllocPlace'}}">+</a>
    </div>
  {{/if}}

  {{!-- max is the allocation and value is the bene held; both move through
        their own controls, so neither is typeable. A GM keeps inputs. --}}
  <div class="pool-inputs{{#unless canEditPools}} locked{{/unless}}">
    {{#if canEditPools}}
      <input type="number" name="system.stats.{{statKey}}.pools.{{poolName}}.value" value="{{pool.value}}" />
      <span>/</span>
      <input type="number" name="system.stats.{{statKey}}.pools.{{poolName}}.max" value="{{pool.max}}" />
    {{else}}
      <span class="pool-value{{#if (gt pool.value pool.max)}} over{{/if}}"
            data-tooltip="{{localize 'ISUN.PoolValueHint'}}">{{pool.value}}</span>
      <span class="sep">/</span>
      <span class="pool-max" data-tooltip="{{localize 'ISUN.PoolMaxHint'}}">{{pool.max}}</span>
    {{/if}}
  </div>
  
  <div class="pool-actions">
    {{!-- Quiet until the row is hovered, and plainly dead once the day's four
          rests are gone. The tooltip names the rest it will cost. --}}
    <a class="btn-refresh{{#unless restsLeft}} disabled{{/unless}}"
       data-action="refresh-pool" data-pool="{{poolName}}"
       data-tooltip="{{refreshTip}}">
      <i class="fa-solid fa-arrows-rotate"></i>
    </a>
  </div>
</div>
