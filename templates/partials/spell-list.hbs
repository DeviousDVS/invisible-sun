<div class="spell-list item-list">
  <div class="list-header">
    <span class="level">Lvl</span>
    <span class="name">Spell</span>
    <span class="cost">Cost</span>
    <span class="dice">Dice</span>
    <span class="actions">
      <a class="item-create" data-type="Spell" title="Create Spell"><i class="fa-solid fa-plus"></i></a>
    </span>
  </div>
  
  {{#each spells as |item|}}
    <div class="item" data-item-id="{{item.id}}">
      <div class="level"><span class="level-badge">{{item.system.level}}</span></div>
      <div class="name rollable" data-action="roll-spell">
        <span class="color-badge {{colorClass item.system.color}}" title="{{item.system.color}}"></span>
        <span>{{item.name}}</span>
      </div>
      <div class="cost" title="{{item.system.cost}}">{{item.system.cost}}</div>
      <div class="dice" title="{{item.system.dice}}">{{item.system.dice}}</div>
      <div class="actions">
        <a class="btn-cast" data-action="roll-spell" title="Cast"><i class="fa-solid fa-wand-sparkles"></i></a>
        <a class="item-edit" title="Edit"><i class="fa-solid fa-edit"></i></a>
        <a class="item-delete" title="Delete"><i class="fa-solid fa-trash"></i></a>
      </div>
    </div>
  {{/each}}
</div>

{{#if incantations.length}}
<h3 class="list-title">Incantations</h3>
<div class="spell-list item-list incantations">
  <div class="list-header">
    <span class="level">Lvl</span>
    <span class="name">Incantation</span>
    <span class="depletion">Depletion</span>
    <span class="actions"></span>
  </div>
  
  {{#each incantations as |item|}}
    <div class="item" data-item-id="{{item.id}}">
      <div class="level"><span class="level-badge">{{item.system.level}}</span></div>
      <div class="name rollable" data-action="roll-incantation">
        <span class="color-badge {{colorClass item.system.color}}" title="{{item.system.color}}"></span>
        <span>{{item.name}}</span>
      </div>
      <div class="depletion" title="{{item.system.depletion}}">{{item.system.depletion}}</div>
      <div class="actions">
        <a class="btn-cast" data-action="roll-incantation" title="Cast"><i class="fa-solid fa-scroll"></i></a>
        <a class="item-edit" title="Edit"><i class="fa-solid fa-edit"></i></a>
        <a class="item-delete" title="Delete"><i class="fa-solid fa-trash"></i></a>
      </div>
    </div>
  {{/each}}
</div>
{{/if}}
