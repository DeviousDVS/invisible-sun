<div class="inventory-container">
  
  <div class="inventory-section">
    <h3>Ephemera</h3>
    <div class="item-list">
      <div class="list-header">
        <span class="level">Lvl</span>
        <span class="name">Item {{> "systems/invisible-sun/templates/partials/cap-badge.hbs" cap=system.limits.ephemera}}</span>
        <span class="type">Type</span>
        <span class="actions">
          <a class="item-create" data-type="Ephemera" data-action="item-create"><i class="fa-solid fa-plus"></i></a>
        </span>
      </div>
      {{#each ephemera as |item|}}
        <div class="item" data-item-id="{{item.id}}">
          <div class="level">{{item.system.level}}</div>
          <div class="name">
            <span class="color-badge {{colorClass item.system.color}}"></span>
            {{item.name}}
          </div>
          <div class="type">{{item.system.ephemeraType}}</div>
          <div class="actions">
            <a class="item-edit" data-action="item-edit"><i class="fa-solid fa-edit"></i></a>
            <a class="item-delete" data-action="item-delete"><i class="fa-solid fa-trash"></i></a>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="inventory-section mt-4">
    <h3>Objects of Power</h3>
    <div class="item-list">
      <div class="list-header">
        <span class="level">Lvl</span>
        <span class="name">Object {{> "systems/invisible-sun/templates/partials/cap-badge.hbs" cap=system.limits.objectsOfPower}}</span>
        <span class="depletion">Depletion</span>
        <span class="actions">
          <a class="item-create" data-type="ObjectOfPower" data-action="item-create"><i class="fa-solid fa-plus"></i></a>
        </span>
      </div>
      {{#each objectsOfPower as |item|}}
        <div class="item" data-item-id="{{item.id}}">
          <div class="level">{{item.system.level}}</div>
          <div class="name">{{item.name}}</div>
          <div class="depletion" title="{{item.system.depletion}}">{{item.system.depletion}}</div>
          <div class="actions">
            <a class="item-edit" data-action="item-edit"><i class="fa-solid fa-edit"></i></a>
            <a class="item-delete" data-action="item-delete"><i class="fa-solid fa-trash"></i></a>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  {{!-- Orbs and magecoins are separate economies that do not convert into one
        another, so they are totalled and displayed apart. --}}
  <div class="economy-section mt-4">
    <h3>Orbs</h3>
    <div class="purse-grid">
      <div class="coin-field">
        <label>{{localize "ISUN.CurrencyBitsAndBobs"}}</label>
        <input type="number" min="0" name="system.economy.purse.bitsAndBobs" value="{{system.economy.purse.bitsAndBobs}}" />
      </div>
      <div class="coin-field">
        <label>{{localize "ISUN.CurrencyGlass"}}</label>
        <input type="number" min="0" name="system.economy.purse.glass" value="{{system.economy.purse.glass}}" />
      </div>
      <div class="coin-field">
        <label>{{localize "ISUN.CurrencyCrystal"}}</label>
        <input type="number" min="0" name="system.economy.purse.crystal" value="{{system.economy.purse.crystal}}" />
      </div>
      <div class="coin-field">
        <label>{{localize "ISUN.CurrencyGem"}}</label>
        <input type="number" min="0" name="system.economy.purse.gem" value="{{system.economy.purse.gem}}" />
      </div>
      <div class="coin-field">
        <label title="{{localize 'ISUN.CurrencyTrueorbHint'}}">{{localize "ISUN.CurrencyTrueorb"}}</label>
        <input type="number" min="0" name="system.economy.purse.trueorb" value="{{system.economy.purse.trueorb}}" />
      </div>
      <div class="coin-field cursed">
        <label title="{{localize 'ISUN.CurrencyBloodsilverHint'}}">{{localize "ISUN.CurrencyBloodsilver"}}</label>
        <input type="number" min="0" name="system.economy.purse.bloodsilver" value="{{system.economy.purse.bloodsilver}}" />
      </div>
    </div>

    <div class="wealth-summary">
      <span class="wealth-label">{{localize "ISUN.Spendable"}}</span>
      <span class="wealth-value">
        {{system.economy.wealth.gem}}<abbr>g</abbr>
        {{system.economy.wealth.crystal}}<abbr>c</abbr>
        {{system.economy.wealth.remainder}}<abbr>gl</abbr>
      </span>
      {{#if system.economy.bloodsilver.atRisk}}
        <span class="curse-warning" title="{{localize 'ISUN.BloodsilverRiskHint'}}">
          <i class="fa-solid fa-skull"></i>
          {{localize "ISUN.BloodsilverRisk"}} {{system.economy.bloodsilver.challenge}}
        </span>
      {{/if}}
    </div>
  </div>

  <div class="economy-section mt-4">
    <h3>{{localize "ISUN.Magecoins"}}</h3>
    <div class="purse-grid magical">
      <div class="coin-field">
        <label title="{{localize 'ISUN.CurrencyVimHint'}}">{{localize "ISUN.CurrencyVim"}}</label>
        <input type="number" min="0" name="system.economy.purse.vim" value="{{system.economy.purse.vim}}" />
      </div>
      <div class="coin-field">
        <label title="{{localize 'ISUN.CurrencyLuminHint'}}">{{localize "ISUN.CurrencyLumin"}}</label>
        <input type="number" min="0" name="system.economy.purse.lumin" value="{{system.economy.purse.lumin}}" />
      </div>
      <div class="coin-field">
        <label title="{{localize 'ISUN.CurrencyDemontearHint'}}">{{localize "ISUN.CurrencyDemontear"}}</label>
        <input type="number" min="0" name="system.economy.purse.demontear" value="{{system.economy.purse.demontear}}" />
      </div>
    </div>
    <p class="hint">{{localize "ISUN.MagecoinsHint"}}</p>
  </div>

  <div class="economy-section mt-4">
    <h3>Income &amp; Debts</h3>
    <div class="economy-grid">
      <div class="economy-field">
        <label>{{localize "ISUN.WeeklyIncome"}}</label>
        <input type="number" min="0" name="system.economy.income" value="{{system.economy.income}}" />
      </div>
      <div class="economy-field">
        <label>{{localize "ISUN.Debts"}}</label>
        <input type="text" name="system.economy.debts" value="{{system.economy.debts}}" />
      </div>
    </div>
  </div>

  {{!-- House and neighbourhood: a vislae's standing and where they live. --}}
  <div class="isun-panel mt-4">
    <h3>{{localize "ISUN.House"}}</h3>
    <div class="grid-3col">
      <div class="form-group">
        <label>{{localize "ISUN.HouseName"}}</label>
        <input type="text" name="system.house.name" value="{{system.house.name}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ISUN.HouseType"}}</label>
        <input type="text" name="system.house.type" value="{{system.house.type}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ISUN.HouseLevel"}}</label>
        <input type="number" min="0" max="10" name="system.house.level" value="{{system.house.level}}" />
      </div>
      <div class="form-group full-width">
        <label>{{localize "ISUN.Neighborhood"}}</label>
        <input type="text" name="system.house.neighborhood" value="{{system.house.neighborhood}}" />
      </div>
      <div class="form-group full-width">
        <label>{{localize "ISUN.HouseAugments"}}</label>
        <input type="text" name="system.house.augments" value="{{system.house.augments}}" />
      </div>
    </div>
    {{!-- House secrets are augments to the house rather than to the vislae,
          and are capped by the house's size and type. --}}
    <div class="mt-4">
      {{!-- No add button, as with the other two secret areas: a secret is
            granted rather than browsed for, and dropping one on the sheet
            carries its type with it. --}}
      <div class="entry-list-header">
        <label class="section-label">{{localize "ISUN.HouseSecrets"}}</label>
      </div>
      <div class="secret-chips">
        {{#each houseSecrets as |s|}}
          <span class="secret-chip house" data-item-id="{{s.id}}">
            <a data-action="open-item" data-item-id="{{s.id}}">{{s.name}}</a>
            {{#if @root.isGM}}
              <a class="item-delete" title="{{localize 'ISUN.Remove'}}" data-action="item-delete"><i class="fa-solid fa-xmark"></i></a>
            {{/if}}
          </span>
        {{else}}
          <span class="empty-state">{{localize "ISUN.NoHouseSecrets"}}</span>
        {{/each}}
      </div>
      {{isunEditor "system.house.secrets"}}
    </div>
  </div>

</div>
