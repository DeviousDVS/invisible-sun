<form class="deck-importer-form flexcol" autocomplete="off">

  {{!-- Said plainly and first. Somebody arriving here has just installed a
        system with empty compendia and wants to know what is being asked of
        them and where their book is going. --}}
  <p class="notes">{{localize "ISUN.ImportIntro"}}</p>

  <div class="form-group">
    <label>{{localize "ISUN.ImportDeck"}}</label>
    <select name="deck">
      {{#each decks as |d|}}<option value="{{d.key}}">{{d.label}}</option>{{/each}}
    </select>
  </div>

  <div class="form-group">
    <label>{{localize "ISUN.ImportPdf"}}</label>
    <input type="file" name="pdf" accept="application/pdf,.pdf" />
  </div>
  <p class="hint">{{localize "ISUN.ImportPdfHint"}}</p>

  <div class="form-group">
    <label>{{localize "ISUN.ImportSize"}}</label>
    <select name="size">
      <option value="256">256 px</option>
      <option value="512" selected>512 px</option>
      <option value="768">768 px</option>
    </select>
  </div>

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="run" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid {{#if busy}}fa-spinner fa-spin{{else}}fa-file-import{{/if}}"></i>
      {{#if busy}}{{localize "ISUN.ImportWorking"}}{{else}}{{localize "ISUN.ImportStart"}}{{/if}}
    </button>
  </footer>

  {{#if log}}
    <ol class="import-log">
      {{#each log as |line|}}<li class="{{#if line.failed}}failed{{/if}}">{{line.text}}</li>{{/each}}
    </ol>
  {{/if}}
</form>
