<div class="arcs-container">
  <div class="arcs-header">
    <h2>{{localize "ISUN.CharacterArcs"}}</h2>
    <a class="item-create" data-type="CharacterArc" title="{{localize 'ISUN.ArcCreate'}}"
       data-action="item-create"><i class="fa-solid fa-plus"></i> {{localize "ISUN.ArcNew"}}</a>
  </div>
  
  {{#each arcs as |arc|}}
    <div class="arc-card item" data-item-id="{{arc.id}}">
      <div class="arc-header">
        <h3>{{arc.name}} <span class="arc-status {{arc.system.status}}">{{localize (concat "ISUN.Arc" (capitalize arc.system.status))}}</span></h3>
        <div class="arc-actions">
          <a class="item-edit" title="{{localize 'ISUN.ArcEdit'}}" data-action="item-edit"><i class="fa-solid fa-edit"></i></a>
          <a class="item-delete" title="{{localize 'ISUN.ArcDelete'}}" data-action="item-delete"><i class="fa-solid fa-trash"></i></a>
        </div>
      </div>
      <p class="arc-desc">{{arc.system.description}}</p>
      
      <div class="arc-timeline">
        {{!-- The book's name for the beat, where it has one. The label alone
              said "Opening" on every arc in the list; the name is what tells
              one from another at a glance. --}}
        <div class="timeline-step {{#if arc.system.opening.completed}}completed{{/if}}">
          <div class="step-indicator"></div>
          <div class="step-content">
            <span class="step-title">{{localize "ISUN.ArcOpening"}}</span>
            {{#if arc.system.opening.title}}
              <span class="step-name">{{arc.system.opening.title}}</span>
            {{/if}}
            <span class="step-reward">{{arc.system.opening.reward}}</span>
          </div>
        </div>
        
        {{#each arc.system.steps as |step index|}}
          <div class="timeline-step {{#if step.completed}}completed{{/if}}">
            <div class="step-indicator"></div>
            <div class="step-content">
              <span class="step-title">{{localize "ISUN.ArcStep" n=(add index 1)}}</span>
              {{#if step.title}}<span class="step-name">{{step.title}}</span>{{/if}}
              <span class="step-desc">{{step.description}}</span>
              <span class="step-reward">{{step.reward}}</span>
            </div>
          </div>
        {{/each}}
        
        <div class="timeline-step {{#if arc.system.climax.completed}}completed{{/if}}">
          <div class="step-indicator climax"></div>
          <div class="step-content">
            <span class="step-title">{{localize "ISUN.ArcClimax"}}</span>
            {{#if arc.system.climax.title}}
              <span class="step-name">{{arc.system.climax.title}}</span>
            {{/if}}
            <span class="step-reward">{{arc.system.climax.reward}}</span>
          </div>
        </div>
        
        <div class="timeline-step {{#if arc.system.resolution.completed}}completed{{/if}}">
          <div class="step-indicator"></div>
          <div class="step-content">
            <span class="step-title">{{localize "ISUN.ArcResolution"}}</span>
            {{#if arc.system.resolution.title}}
              <span class="step-name">{{arc.system.resolution.title}}</span>
            {{/if}}
            <span class="step-reward">{{arc.system.resolution.reward}}</span>
          </div>
        </div>
      </div>
    </div>
  {{else}}
    <div class="empty-state">{{localize "ISUN.NoArcs"}}</div>
  {{/each}}
</div>
