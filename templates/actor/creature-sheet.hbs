{{!-- A creature, in the order a GM needs it: what it can take and what it can
      do first, the prose that tells them how to play it underneath.

      That is the reverse of the book, which opens every entry with a page of
      second-person description and puts the numbers at the foot. The book is
      read once, before the session; this is read during one, with a player
      waiting. --}}
<div class="{{cssClass}} flexcol" autocomplete="off">
  {{> "systems/invisible-sun/templates/partials/header-bar.hbs"}}

  <section class="sheet-body single-page creature-sheet-body">
    {{> "systems/invisible-sun/templates/partials/non-player-health.hbs"}}
    {{> "systems/invisible-sun/templates/partials/stat-block.hbs"}}

    <div class="prose-section">
      <h3>{{localize "ISUN.EntryDescription"}}</h3>
      {{isunEditor "system.description"}}
    </div>

    {{!-- Kept beneath the description rather than beside the stat block. The
          importer writes the book's prose to `description` and nothing to this,
          so on an imported creature it is an empty box waiting for whatever the
          GM works out at the table about how the thing actually fights. --}}
    <div class="prose-section gm-jottings">
      <h3>{{localize "ISUN.Combat"}}</h3>
      {{isunEditor "system.combat"}}
    </div>

    {{> "systems/invisible-sun/templates/partials/entry-source.hbs"}}
  </section>
</div>
