{{!-- The five orders share almost no interface — Vancean slots, thread weaving,
      Goetic pacts and Maker matrices are different games — so this dispatches
      on the character's order rather than showing one merged view. --}}
<div class="order-workspace">

  {{#if order}}
    <div class="isun-panel order-header">
      <div class="order-title">
        <img class="order-img" src="{{order.img}}" alt="{{order.name}}" />
        <div>
          <h3>{{order.name}}</h3>
          {{#if orderDegree}}
            <div class="order-degree">
              <span class="degree-number">{{localize "ISUN.DegreeOrdinal"}} {{orderDegree}}</span>
              {{#if orderDegreeTitle}}<span class="degree-title">{{orderDegreeTitle}}</span>{{/if}}
            </div>
          {{/if}}
          {{#if orderInfo.magicStyle}}
            <div class="order-style">{{orderInfo.magicStyle}}</div>
          {{/if}}
        </div>
      </div>
      {{#if order.system.philosophy}}
        <div class="order-philosophy">{{{order.system.philosophy}}}</div>
      {{/if}}

      {{!-- The ladder is worth having to hand but is not read often, and shown
            in full it buries the rest of the tab. It collapses twice over: the
            whole thing, and then each degree, so the usual view is six lines. --}}
      {{#if degreeLadder.length}}
        <div class="degree-ladder{{#if ladderOpen}} open{{/if}}">
          <a class="ladder-toggle" data-action="toggle-ladder">
            <i class="fa-solid fa-caret-{{#if ladderOpen}}down{{else}}right{{/if}}"></i>
            {{localize "ISUN.Degrees"}}
            <span class="ladder-here">{{orderDegreeTitle}}</span>
          </a>
          <div class="ladder-body">
            {{#each degreeLadder as |d|}}
              <div class="degree{{#if d.attained}} attained{{/if}}{{#if d.current}} current{{/if}}{{#if d.expanded}} expanded{{/if}}"
                   data-degree="{{d.degree}}">
                <a class="degree-head" data-action="toggle-degree" data-degree="{{d.degree}}">
                  <span class="degree-rank">{{d.degree}}</span>
                  <span class="degree-name">{{d.title}}</span>
                  {{#unless d.attained}}
                    <span class="degree-cost" data-tooltip="{{localize 'ISUN.DegreeCostHint'}}">{{d.cost}} <i class="fa-solid fa-star"></i></span>
                  {{/unless}}
                  <span class="degree-count">{{d.abilities.length}}</span>
                </a>
                <div class="degree-detail">
                  {{#if d.requirement}}<div class="degree-req">{{{d.requirement}}}</div>{{/if}}
                  <ul class="degree-abilities">
                    {{#each d.abilities as |a|}}
                      <li><span class="ability-name">{{a.name}}</span>{{{a.description}}}</li>
                    {{/each}}
                  </ul>
                </div>
              </div>
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{!-- An Apostate has no ladder, but their abilities are the same kind of
            reference — read when spending Crux, in the way at every other time.
            So they take the ladder's place in the header and collapse with it,
            rather than sitting in a panel of their own below. --}}
      {{#if isApostate}}
        <div class="degree-ladder apostate-abilities{{#if ladderOpen}} open{{/if}}">
          <a class="ladder-toggle" data-action="toggle-ladder">
            <i class="fa-solid fa-caret-{{#if ladderOpen}}down{{else}}right{{/if}}"></i>
            {{localize "ISUN.ApostateAbilities"}}
            <span class="ladder-here">{{localize "ISUN.ApostateNoDegrees"}}</span>
          </a>
          <div class="ladder-body">
            <p class="hint">{{localize "ISUN.ApostateHint"}}</p>

            <div class="apostate-group">
              <h4>{{localize "ISUN.ApostateStarting"}}
                <span class="degree-count">{{apostateStarting.length}}</span></h4>
              {{#if apostateStartingNote}}
                <div class="group-note">{{{apostateStartingNote}}}</div>
              {{/if}}
              <ul class="degree-abilities">
                {{#each apostateStarting as |a|}}
                  <li><span class="ability-name">{{a.name}}</span>{{{a.description}}}</li>
                {{/each}}
              </ul>
            </div>

            <div class="apostate-group">
              <h4>{{localize "ISUN.ApostatePurchasable"}}
                <span class="degree-count">{{apostatePurchasable.length}}</span></h4>
              {{#if apostatePurchasableNote}}
                <div class="group-note">{{{apostatePurchasableNote}}}</div>
              {{/if}}
              <ul class="degree-abilities muted">
                {{#each apostatePurchasable as |a|}}
                  <li><span class="ability-name">{{a.name}}</span>{{{a.description}}}</li>
                {{/each}}
              </ul>
            </div>
          </div>
        </div>
      {{/if}}
    </div>
  {{else}}
    <div class="empty-state">{{localize "ISUN.NoOrder"}}</div>
  {{/if}}

  {{#if (eq orderKey "weaver")}}
    {{!-- Aggregates are the raw material of Weaver magic: qualities define what
          a thread can be woven into, absences what it cannot. --}}
    <div class="isun-panel mt-4">
      <div class="entry-list-header">
        <h3>{{localize "ISUN.Aggregates"}}</h3>
        {{!-- Every aggregate is printed in The Way, so this opens the pack
              rather than making a blank one to retype it into. Creating one
              from scratch is a button inside that window. --}}
        <a class="item-pick" data-action="pick-thread" title="{{localize 'ISUN.AddThread'}}">
          <i class="fa-solid fa-plus"></i>
        </a>
      </div>
      <p class="hint">{{localize "ISUN.AggregatesHint"}}</p>

      {{#each threads as |thread|}}
        <div class="thread-card item" data-item-id="{{thread.id}}">
          <div class="thread-head">
            <span class="color-badge {{colorClass thread.system.color}}" title="{{thread.system.color}}"></span>
            <span class="thread-name">{{thread.name}}</span>
            <span class="thread-meta">
              {{#if thread.system.defaultRange}}{{thread.system.defaultRange}}{{/if}}
              {{#if thread.system.defaultDuration}} · {{thread.system.defaultDuration}}{{/if}}
            </span>
            <span class="thread-actions">
              <a class="item-edit" title="{{localize 'ISUN.Edit'}}" data-action="item-edit"><i class="fa-solid fa-edit"></i></a>
              <a class="item-delete" title="{{localize 'ISUN.Remove'}}" data-action="item-delete"><i class="fa-solid fa-trash"></i></a>
            </span>
          </div>
          <div class="thread-body">
            <div class="thread-col qualities">
              <span class="thread-col-label">{{localize "ISUN.Qualities"}}</span>
              {{#each thread.system.qualities as |q|}}<span class="tag quality">{{q}}</span>{{/each}}
            </div>
            <div class="thread-col absences">
              <span class="thread-col-label">{{localize "ISUN.Absences"}}</span>
              {{#each thread.system.absences as |a|}}<span class="tag absence">{{a}}</span>{{/each}}
            </div>
          </div>
        </div>
      {{else}}
        <div class="empty-state">{{localize "ISUN.NoThreads"}}</div>
      {{/each}}
    </div>
  {{/if}}

</div>
