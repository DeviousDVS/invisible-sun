{{!-- Everything a vislae can bring to bear, in one list. The rules give spells,
      incantations, forte abilities and minor magics the same shape — level,
      colour, cost, dice, depletion — so they sort together rather than sitting
      in four lists that cannot be compared. --}}
<div class="practices" data-filter="{{practiceFilter}}">

  <div class="practices-head">
    <h3>{{localize "ISUN.Practices"}}</h3>
    <div class="practice-filters">
      <a data-action="filter-practices" class="practice-filter{{#if (eq practiceFilter "all")}} active{{/if}}" data-kind="all">
        {{localize "ISUN.KindAll"}} <span class="count">{{practices.length}}</span>
      </a>
      {{#each practiceKinds as |k|}}
        {{#if k.count}}
          <a data-action="filter-practices" class="practice-filter{{#if (eq ../practiceFilter k.key)}} active{{/if}}" data-kind="{{k.key}}">
            {{localize k.label}} <span class="count">{{k.count}}</span>
          </a>
        {{/if}}
      {{/each}}
    </div>
  </div>

  {{!-- The Vance's mind. Only a Vance has one, so `mind` is null for every
        other order and this whole block is absent rather than empty: a Weaver
        shown "0 / 0 sq in" would be told a limit that is not theirs.

        The book captions its own diagrams by degree — "Mind of the Postulant",
        "Mind of the Magister" — so the heading follows the degree title. --}}
  {{#if mind}}
    <div class="mind{{#if mind.over}} over{{/if}}">
      <span class="mind-name">
        {{mind.label}}
      </span>
      <span class="mind-bar" data-tooltip="{{localize 'ISUN.MindBarHint'
              used=mind.used total=mind.capacity prepared=mind.prepared
              width=mind.width height=mind.height}}">
        <span class="mind-fill" style="width: {{mind.percent}}%"></span>
      </span>
      <span class="mind-count">{{mind.used}} / {{mind.capacity}}</span>
      {{#if mind.reductions.value}}
        <span class="mind-reductions"
              data-tooltip="{{localize 'ISUN.MindReductionsHint'}}">
          (&frac12;: {{mind.reductions.used}} / {{mind.reductions.value}})
        </span>
      {{/if}}
    </div>
  {{/if}}

  <div class="item-list">
    <div class="list-header">
      <span class="level">{{localize "ISUN.Lvl"}}</span>
      <span class="name">{{localize "ISUN.Name"}}</span>
      <span class="type">{{localize "ISUN.Kind"}}</span>
      <span class="cost">{{localize "ISUN.Cost"}}</span>
      {{#if mind}}<span class="mind-cell">{{localize "ISUN.Mind"}}</span>{{/if}}
      <span class="dice">{{localize "ISUN.Dice"}}</span>
      <span class="shift">{{localize "ISUN.PathShiftColumn"}}</span>
      <span class="depletion">{{localize "ISUN.Depletion"}}</span>
      <span class="actions"></span>
    </div>

    {{#each practices as |p|}}
      <div class="item practice" data-item-id="{{p.item.id}}" data-kind="{{p.kind}}">
        <div class="level">
          <span class="level-badge">{{p.level}}</span>
        </div>
        <div class="name rollable" data-action="{{p.action}}">
          <span class="color-badge {{colorClass p.color}}" title="{{p.color}}"></span>
          <span>{{p.item.name}}</span>
        </div>
        <div class="type" title="{{p.kindLabel}}">{{p.kindLabel}}</div>
        <div class="cost" title="{{p.cost}}">{{p.cost}}</div>
        {{!-- Preparation. Blank for anything the Vancian rules do not reach:
              a general spell, an incantation, a forte ability. The footprint
              doubles as the halving control, because reducing a spell is a
              statement about how much room it takes and that is the number
              being changed. --}}
        {{#if @root.mind}}
          <div class="mind-cell">
            {{#if p.vancian}}
              <input type="checkbox" data-action="toggle-prepared"
                     {{#if p.prepared}}checked{{/if}}
                     {{#unless p.canPrepare}}disabled{{/unless}}
                     data-tooltip="{{#if p.canPrepare}}{{localize 'ISUN.MindPrepareHint'}}{{else}}{{localize p.blockedReason name=p.item.name need=p.footprint free=@root.mind.free}}{{/if}}" />
              {{!-- The number alone, with the accent marking a reduced spell.
                    No fraction glyph beside it: at these sizes "2½" reads as
                    two and a half rather than as a halved 4, and the footprint
                    having changed from 4 to 2 already says it happened. --}}
              <a class="mind-size-tag{{#if p.halved}} halved{{/if}}"
                 data-action="toggle-halved"
                 data-tooltip="{{#if p.halved}}{{localize 'ISUN.MindRestoreHint'}}{{else}}{{localize 'ISUN.MindHalveHint'}}{{/if}}">
                {{p.footprint}}
              </a>
            {{/if}}
          </div>
        {{/if}}
        <div class="dice" title="{{#if p.condition}}{{p.dice}} {{p.condition}}{{else}}{{p.dice}}{{/if}}">{{p.dice}}</div>
        {{!-- What the Path of Suns is doing to a practice of this colour. Its
              own column rather than a badge tucked under the level, because it
              is not a level: the player chooses at the moment of casting
              whether to take the shift as a level or as a Sorcery cost, and
              printing it on the level said one of those two for them. --}}
        <div class="shift">
          {{#if p.shift}}
            <span class="sooth-shift {{#if (gt p.shift.amount 0)}}up{{else}}down{{/if}}"
                  data-tooltip="{{localize 'ISUN.PathShiftHint' amount=p.shift.text sources=p.shift.sources}}">
              {{p.shift.text}}
            </span>
          {{/if}}
        </div>
        <div class="depletion" title="{{p.depletion}}">{{p.depletion}}</div>
        <div class="actions">
          <a class="btn-cast" data-action="{{p.action}}" title="{{localize 'ISUN.Use'}}">
            <i class="fa-solid fa-wand-sparkles"></i>
          </a>
          <a class="item-edit" title="{{localize 'ISUN.Edit'}}" data-action="item-edit"><i class="fa-solid fa-edit"></i></a>
          <a class="item-delete" title="{{localize 'ISUN.Remove'}}" data-action="item-delete"><i class="fa-solid fa-trash"></i></a>
        </div>
      </div>
    {{else}}
      <div class="empty-state">{{localize "ISUN.NoPractices"}}</div>
    {{/each}}
  </div>

  <div class="practice-add">
    <a class="item-create" data-type="Spell" data-action="item-create"><i class="fa-solid fa-plus"></i> {{localize "TYPES.Item.Spell"}}</a>
    {{!-- An incantation is granted, not picked: the universe decides what the
          character gets. So this draws one rather than making a blank item or
          opening a list. --}}
    <a class="item-pick" data-action="grant-incantation"><i class="fa-solid fa-plus"></i> {{localize "TYPES.Item.Incantation"}}</a>
    {{!-- Unlike the others, a forte ability is not invented on the spot: it is
          taken from the forte's tree, along a path, for Crux. So this opens the
          tree rather than creating an empty item. --}}
    <a data-action="pick-forte-ability" data-tooltip="{{localize 'ISUN.FortePickerHint'}}">
      <i class="fa-solid fa-plus"></i> {{localize "TYPES.Item.ForteAbility"}}
    </a>
    <a class="item-create" data-type="MinorMagic" data-action="item-create"><i class="fa-solid fa-plus"></i> {{localize "TYPES.Item.MinorMagic"}}</a>
  </div>
</div>
