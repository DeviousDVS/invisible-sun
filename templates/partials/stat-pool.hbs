{{!-- Scourges inflicted at a wider scope than one pool. Those from Wounds and
      Anguish are derived and appear on the pools themselves. --}}
<div class="scourge-bar">
  <span class="scourge-bar-label" title="{{localize 'ISUN.ScourgeHint'}}">{{localize "ISUN.Scourges"}}</span>
  <div class="scourge-scope">
    <label title="{{localize 'ISUN.ScourgeAllHint'}}">{{localize "ISUN.ScourgeAll"}}</label>
    <input type="number" min="0" name="system.status.scourge.all" value="{{system.status.scourge.all}}" />
  </div>
  <div class="scourge-scope">
    <label>{{localize "ISUN.ScourgeCertes"}}</label>
    <input type="number" min="0" name="system.status.scourge.certes" value="{{system.status.scourge.certes}}" />
  </div>
  <div class="scourge-scope">
    <label>{{localize "ISUN.ScourgeQualia"}}</label>
    <input type="number" min="0" name="system.status.scourge.qualia" value="{{system.status.scourge.qualia}}" />
  </div>
  {{#if system.status.worstScourge}}
    <span class="scourge-worst{{#if (gte system.status.worstScourge 3)}} critical{{/if}}"
          title="{{localize 'ISUN.WorstScourgeHint'}}">
      {{localize "ISUN.Worst"}} −{{system.status.worstScourge}}
    </span>
  {{/if}}
</div>

{{#if showAllocation}}
  <div class="alloc-banner">
    <span class="alloc-label">{{localize "ISUN.PointsToPlace"}}</span>
    <span class="alloc-count">{{unspentPoints}}</span>
    <span class="alloc-hint">{{localize "ISUN.PointsToPlaceHint"}}</span>
  </div>
{{/if}}

<div class="stat-group">
  <div class="stat-column certes">
    <div class="stat-header">
      <h2>{{localize "ISUN.StatCertes"}}</h2>
      {{!-- The score is the sum of its pools, so it is shown, not typed:
            "points not put in a pool serve no purpose" (The Key, p1875). --}}
      <div class="stat-totals derived" data-tooltip="{{localize 'ISUN.StatDerivedHint'}}">
        <span class="stat-score">{{system.stats.certes.value}}</span>
      </div>
    </div>
    
    {{> "systems/invisible-sun/templates/partials/stat-pool-row.hbs" poolName="accuracy" statKey="certes" pool=system.stats.certes.pools.accuracy label="ISUN.PoolAccuracy"}}
    {{> "systems/invisible-sun/templates/partials/stat-pool-row.hbs" poolName="movement" statKey="certes" pool=system.stats.certes.pools.movement label="ISUN.PoolMovement"}}
    {{> "systems/invisible-sun/templates/partials/stat-pool-row.hbs" poolName="physicality" statKey="certes" pool=system.stats.certes.pools.physicality label="ISUN.PoolPhysicality"}}
    {{> "systems/invisible-sun/templates/partials/stat-pool-row.hbs" poolName="perception" statKey="certes" pool=system.stats.certes.pools.perception label="ISUN.PoolPerception"}}
  </div>

  <div class="stat-column qualia">
    <div class="stat-header">
      <h2>{{localize "ISUN.StatQualia"}}</h2>
      {{!-- The score is the sum of its pools, so it is shown, not typed:
            "points not put in a pool serve no purpose" (The Key, p1875). --}}
      <div class="stat-totals derived" data-tooltip="{{localize 'ISUN.StatDerivedHint'}}">
        <span class="stat-score">{{system.stats.qualia.value}}</span>
      </div>
    </div>
    
    {{> "systems/invisible-sun/templates/partials/stat-pool-row.hbs" poolName="sorcery" statKey="qualia" pool=system.stats.qualia.pools.sorcery label="ISUN.PoolSorcery"}}
    {{> "systems/invisible-sun/templates/partials/stat-pool-row.hbs" poolName="interaction" statKey="qualia" pool=system.stats.qualia.pools.interaction label="ISUN.PoolInteraction"}}
    {{> "systems/invisible-sun/templates/partials/stat-pool-row.hbs" poolName="intellect" statKey="qualia" pool=system.stats.qualia.pools.intellect label="ISUN.PoolIntellect"}}
    
    {{!-- Sortilege holds enhancements rather than bene, hence the pip override --}}
    {{> "systems/invisible-sun/templates/partials/stat-pool-row.hbs" poolName="sortilege" statKey="qualia" pool=system.stats.qualia.pools.sortilege label="ISUN.PoolSortilege" pipClass="enhancement-pip"}}
  </div>
</div>
