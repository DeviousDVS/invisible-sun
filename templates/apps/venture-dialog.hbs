{{!-- Venture = skills + bene + other modifiers; it is subtracted from the
      challenge to give the number needed on the die. Enhancements are kept
      separate because they add a die rather than venture.

      The wrapper is a div, not a form: DialogV2 supplies its own form and
      discards any the content brings, which would take this class with it and
      leave every selector and style below unmatched. --}}
<div class="venture-dialog">
  <input type="hidden" name="label" value="{{label}}" />

  <div class="venture-summary">
    <div class="vs-cell">
      <span class="vs-label">{{localize "ISUN.Challenge"}}</span>
      <input type="number" name="challenge" value="{{challenge}}" min="0" max="20" autofocus />
    </div>
    <div class="vs-cell">
      <span class="vs-label">{{localize "ISUN.Venture"}}</span>
      <span class="venture-total">0</span>
    </div>
    <div class="vs-cell target">
      <span class="vs-label">{{localize "ISUN.NeedToRoll"}}</span>
      <span class="target-total">0</span>
    </div>
  </div>

  {{#if skills.length}}
    <fieldset class="venture-skills">
      <legend>{{localize "ISUN.Skills"}}</legend>
      <p class="hint">{{localize "ISUN.VentureTwoSkillsHint"}}</p>
      {{!-- Empty on purpose: SkillPicker fills it, because what is chosen keeps
            changing while the dialog is open and a template can only draw what
            was chosen when it opened. Each row carries a hidden input named
            "skills", so FormDataExtended reads them as a list of ids. --}}
      <div class="skill-picks"></div>
      <a class="item-pick add-skill" data-tooltip="{{localize 'ISUN.SkillPickerAddHint'}}">
        <i class="fa-solid fa-plus"></i> {{localize "TYPES.Item.Skill"}}
      </a>
    </fieldset>
  {{/if}}

  {{!-- Guarded because a declared pool withdraws the bene rows, and a character
        with no Sortilege then has nothing left to put in here. --}}
  {{#if pools.length}}
  <fieldset class="venture-pools">
    <legend>{{localize "ISUN.SpendFromPools"}}</legend>
    <div class="pool-spends">
      {{#each pools as |p|}}
        <div class="pool-spend-row {{#if p.isEnhancement}}enhancement{{/if}}">
          <span class="pool-name">{{p.label}}</span>
          {{!-- One pip per point that could go on this action: what the pool
                holds, or what the rules allow, whichever runs out first. The
                hidden input is what the form reads and what the running venture
                watches. Sortilege is drawn in its own colour, as the sheet
                draws it, because an enhancement buys a die and a bene buys
                venture. --}}
          {{#if p.isEnhancement}}
            <span class="enh-pips" data-tooltip="{{@root.sortilegeHint}}">
              <input type="hidden" name="pool.{{p.key}}" value="0" class="enh-spend" />
              {{#times p.spendable}}
                <a class="spend-pip enhancement-pip" data-n="{{add @index 1}}"></a>
              {{/times}}
              {{#unless p.spendable}}<span class="spend-none">—</span>{{/unless}}
            </span>
          {{else}}
            <span class="bene-pips" data-tooltip="{{@root.beneHint}}">
              <input type="hidden" name="pool.{{p.key}}" value="0" class="bene-spend" />
              {{#times p.spendable}}
                <a class="spend-pip bene-pip" data-n="{{add @index 1}}"></a>
              {{/times}}
            </span>
          {{/if}}
          <span class="pool-avail">/ {{p.value}}</span>
          <span class="pool-effect">{{#if p.isEnhancement}}+1 die{{else}}+1 venture{{/if}}</span>
        </div>
      {{/each}}
    </div>
  </fieldset>
  {{/if}}

  {{!-- What the pool the action draws on brings with it. Only ever present when
        the action named a pool, which today means a magical practice.

        The scourge is the pool's own state — shown, already counted, and not
        the player's to decline. The vex is offered at zero because "the GM
        decides when" (The Key, p2241): it is called in at the table, not
        volunteered. --}}
  {{#if drain}}
    <fieldset class="venture-drain">
      <legend>{{localize "ISUN.PoolTakes" pool=drain.label}}</legend>
      {{#if drain.scourge}}
        <div class="drain-row" data-tooltip="{{localize 'ISUN.ScourgeHint'}}">
          <span class="drain-name">{{localize "ISUN.Scourge"}}</span>
          <strong class="vd-penalty">&minus;{{drain.scourge}}</strong>
          <span class="pool-effect">{{localize "ISUN.ScourgeStands"}}</span>
        </div>
      {{/if}}
      {{#if drain.vex}}
        <label class="drain-row vex" data-tooltip="{{localize 'ISUN.VexSpendHint'}}">
          <span class="drain-name">{{localize "ISUN.Vex"}}</span>
          <input type="number" name="vexSpend" min="0" max="{{drain.vex}}" value="0" />
          <span class="pool-avail">/ {{drain.vex}}</span>
          <span class="pool-effect">&minus;1 {{localize "ISUN.Venture"}}</span>
        </label>
      {{/if}}
    </fieldset>
  {{/if}}

  <div class="venture-extras">
    <label>
      <span>{{localize "ISUN.MagicDice"}}</span>
      <input type="number" name="magicDice" value="{{magicDice}}" min="0" max="3" />
    </label>
    <label>
      <span>{{localize "ISUN.OtherModifier"}}</span>
      <input type="number" name="modifier" value="0" />
    </label>
  </div>

  {{!-- The practice's own level. "You always add the level of the effect to the
        venture" (The Way, p7), so it is not the player's to decline — shown,
        like the board's, and already counted. --}}
  {{#if base}}
    <div class="vd-sooth" data-tooltip="{{baseLabel}}">
      {{baseLabel}}
      <strong class="vd-bonus">+{{base}}</strong>
    </div>
  {{/if}}

  {{!-- The board's, not the player's, so it is shown rather than offered. It is
        already in the running venture above. --}}
  {{#if sooth}}
    <div class="vd-sooth" data-tooltip="{{soothSources}}">
      {{localize "ISUN.PathTitle"}}
      <strong class="{{#if (gt sooth 0)}}vd-bonus{{else}}vd-penalty{{/if}}">{{soothText}}</strong>
      <span class="from">{{soothSources}}</span>
    </div>
  {{/if}}
</div>
