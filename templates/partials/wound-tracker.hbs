<div class="health-tracking">
  <div class="health-row wounds-row">
    <label>{{localize "ISUN.Wounds"}}</label>
    <div class="health-pips">
      {{#times (subtract system.status.wounds.max system.status.wounds.value)}}
        <span class="wound-pip empty" data-action="add-wound"></span>
      {{/times}}
      {{#times system.status.wounds.value}}
        <span class="wound-pip full" data-action="remove-wound"></span>
      {{/times}}
    </div>
    {{#if system.status.dead}}
      <span class="health-flag dead" title="{{localize 'ISUN.DeadHint'}}">
        <i class="fa-solid fa-skull"></i> {{localize "ISUN.Dead"}}
      </span>
    {{/if}}
  </div>

  <div class="health-row anguish-row">
    <label>{{localize "ISUN.Anguish"}}</label>
    <div class="health-pips">
      {{#times (subtract system.status.anguish.max system.status.anguish.value)}}
        <span class="anguish-pip empty" data-action="add-anguish"></span>
      {{/times}}
      {{#times system.status.anguish.value}}
        <span class="anguish-pip full" data-action="remove-anguish"></span>
      {{/times}}
    </div>
    {{#if system.status.broken}}
      <span class="health-flag broken" title="{{localize 'ISUN.BrokenHint'}}">
        <i class="fa-solid fa-brain"></i> {{localize "ISUN.Broken"}}
      </span>
    {{/if}}
  </div>

  {{!-- One shared Injury track. Each pip records where it came from, because
        the pip that fills the track decides whether the set becomes a Wound or
        an Anguish. --}}
  <div class="injuries-row">
    <label>{{localize "ISUN.Injuries"}}</label>
    <div class="injury-track">
      {{#each system.status.injuries as |source i|}}
        <span class="injury-pip full {{source}}" data-action="remove-injury" data-index="{{i}}"
              title="{{localize (concat "ISUN.Injury" (capitalize source))}}"></span>
      {{/each}}
      {{#times (subtract system.status.injuryProgress.threshold system.status.injuryProgress.count)}}
        <span class="injury-pip empty"></span>
      {{/times}}
      <span class="injury-add">
        <a data-action="add-injury" data-source="physical" title="{{localize 'ISUN.AddPhysicalInjury'}}">
          <i class="fa-solid fa-droplet"></i>
        </a>
        <a data-action="add-injury" data-source="mental" title="{{localize 'ISUN.AddMentalInjury'}}">
          <i class="fa-solid fa-brain"></i>
        </a>
      </span>
    </div>
  </div>
  <p class="hint injury-hint">{{localize "ISUN.InjuryTrackHint"}}</p>

  <div class="defenses-row">
    <div class="defense-group">
      <label>{{localize "ISUN.Armor"}}</label>
      <input type="number" name="system.status.armor" value="{{system.status.armor}}" min="0" />
    </div>
    <div class="defense-group">
      <label>{{localize "ISUN.Ward"}}</label>
      <input type="number" name="system.status.ward" value="{{system.status.ward}}" min="0" />
    </div>
  </div>
</div>
