{{!-- Skills sit with the pools because both feed a venture: a skill adds its
      level, bene adds from a pool, and the roll dialog draws on both.
      Grouped by category since that is what a new level costs in Acumen. --}}
<div class="skills-block">
  <div class="skills-header">
    <h3>{{localize "ISUN.Skills"}}</h3>
    <a class="item-create" data-type="Skill" title="{{localize 'ISUN.SkillCreate'}}">
      <i class="fa-solid fa-plus"></i>
    </a>
  </div>

  {{#each skillGroups as |group|}}
    <div class="skill-group {{group.key}}">
      <div class="skill-group-header">
        <span class="skill-group-name">{{group.label}}</span>
        <span class="skill-group-cost" data-tooltip="{{localize 'ISUN.SkillAcumenHint'}}">
          {{group.acumenCost}} <i class="fa-solid fa-graduation-cap"></i> / level
        </span>
      </div>

      {{#if group.skills.length}}
        <div class="item-list skill-list">
          {{#each group.skills as |item|}}
            <div class="item skill" data-item-id="{{item.id}}">
              <a class="name rollable" data-action="roll-skill"
                 data-tooltip="{{localize 'ISUN.SkillRollHint'}}">
                <img src="{{item.img}}" alt="" width="20" height="20" />
                <span>{{item.name}}</span>
              </a>
              <div class="level">
                <input type="number" min="0" max="{{item.maxLevel}}"
                       data-action="skill-level" data-item-id="{{item.id}}"
                       value="{{item.system.level}}" />
              </div>
              <div class="venture" data-tooltip="{{localize 'ISUN.SkillVentureHint'}}">
                +{{item.system.level}}
              </div>
              <div class="actions">
                <a class="item-edit" title="{{localize 'ISUN.Edit'}}"><i class="fa-solid fa-edit"></i></a>
                <a class="item-delete" title="{{localize 'ISUN.Delete'}}"><i class="fa-solid fa-trash"></i></a>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="skill-empty">{{localize "ISUN.SkillNone"}}</p>
      {{/if}}
    </div>
  {{/each}}
</div>
