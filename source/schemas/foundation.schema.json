{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "Foundation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "weekly_income": {
      "type": "integer"
    },
    "initial_savings": {
      "type": "integer"
    },
    "starting_hidden_knowledge": {
      "type": "integer"
    },
    "house": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "level"
      ]
    },
    "connections": {
      "type": "integer"
    },
    "connections_text": {
      "type": "string"
    },
    "special": {
      "type": "string"
    },
    "initial_motivations": {
      "type": "string"
    },
    "suggested_character_arcs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "description",
    "weekly_income",
    "initial_savings",
    "starting_hidden_knowledge",
    "house"
  ]
}