<div class="narrative-container">

  <div class="narrative-section">
    <h3>{{localize "ISUN.Appearance"}}</h3>
    {{isunEditor "system.narrative.appearance"}}
    <div class="form-group full-width mt-4">
      <label>{{localize "ISUN.Quirk"}}</label>
      {{!-- A datalist suggests without constraining: the rules invite a player
            to invent their own, so anything typed here is still valid. --}}
      <input type="text" name="system.narrative.quirk" value="{{system.narrative.quirk}}"
             list="isun-quirks" placeholder="{{localize 'ISUN.QuirkPlaceholder'}}" />
      <datalist id="isun-quirks">
        {{#each config.quirks as |q|}}<option value="{{q}}"></option>{{/each}}
      </datalist>
    </div>

    {{!-- Changery secrets sit with Appearance because that is what they cost:
          each one only works once the body has been altered to suit it, always
          a change of level 9 or higher. Drop a Secret on the sheet to add one;
          the chip shows the change the secret is waiting on. --}}
    <div class="mt-4">
      <div class="entry-list-header">
        <label class="section-label">{{localize "ISUN.ChangerySecrets"}}</label>
      </div>
      <p class="hint">{{localize "ISUN.ChangerySecretsHint"}}</p>
      <div class="secret-chips">
        {{#each changerySecrets as |s|}}
          <span class="secret-chip changery" data-item-id="{{s.id}}">
            <a data-action="open-item" data-item-id="{{s.id}}"
               {{#if s.system.changeRequired}}data-tooltip="{{localize 'ISUN.ChangeRequired'}}: {{s.system.changeRequired}}"{{/if}}>{{s.name}}</a>
            {{#if @root.isGM}}
              <a class="item-delete" title="{{localize 'ISUN.Remove'}}" data-action="item-delete"><i class="fa-solid fa-xmark"></i></a>
            {{/if}}
          </span>
        {{else}}
          <span class="empty-state">{{localize "ISUN.NoChangerySecrets"}}</span>
        {{/each}}
      </div>
    </div>
  </div>

  <div class="narrative-section mt-4">
    <h3>{{localize "ISUN.ShadowLife"}}</h3>
    <p class="hint">{{localize "ISUN.ShadowLifeHint"}}</p>
    {{isunEditor "system.narrative.shadowLife"}}
  </div>

  {{> "systems/invisible-sun/templates/partials/entry-list.hbs"
      entries=system.narrative.memories path="system.narrative.memories"
      heading=(localize "ISUN.Memories") hint=(localize "ISUN.MemoriesHint")}}

  {{> "systems/invisible-sun/templates/partials/entry-list.hbs"
      entries=system.narrative.personality path="system.narrative.personality"
      heading=(localize "ISUN.Personality") hint=(localize "ISUN.PersonalityHint")}}

  <div class="narrative-section mt-4">
    <h3>{{localize "ISUN.Notes"}}</h3>
    {{isunEditor "system.biography"}}
  </div>

  <div class="narrative-section mt-4">
    <h3>{{localize "ISUN.PlayerInfo"}}</h3>
    <div class="grid-2col">
      <div class="form-group">
        <label>{{localize "ISUN.PlayerName"}}</label>
        <input type="text" name="system.player.name" value="{{system.player.name}}" />
      </div>
      <div class="form-group">
        <label>{{localize "ISUN.RpStyle"}}</label>
        <input type="text" name="system.player.rpStyle" value="{{system.player.rpStyle}}"
               placeholder="{{localize 'ISUN.RpStylePlaceholder'}}" />
      </div>
    </div>
  </div>

</div>
