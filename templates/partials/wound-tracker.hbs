{{!-- A Wound and an Anguish are the GM's to give and to take back, the way a
      vex is: they arrive from damage the GM applies, and a player clicking a
      pip was writing down an injury nobody had dealt. So the pips carry an
      action for a GM and none for a player, who reads their own track and sees
      what it costs on the pools beneath it.

      The attribute is what makes a pip live — no data-action, no handler — so
      the cursor is keyed off the same attribute rather than asserted twice. --}}
<div class="health-tracking">
  <div class="health-row wounds-row">
    <label>{{localize "ISUN.Wounds"}}</label>
    <div class="health-pips">
      {{#times (subtract system.status.wounds.max system.status.wounds.value)}}
        <span class="wound-pip empty" {{#if @root.isGM}}data-action="add-wound"{{/if}}></span>
      {{/times}}
      {{#times system.status.wounds.value}}
        <span class="wound-pip full" {{#if @root.isGM}}data-action="remove-wound"{{/if}}></span>
      {{/times}}
    </div>
    {{#if system.status.dead}}
      <span class="health-flag dead" title="{{localize 'ISUN.DeadHint'}}">
        <i class="fa-solid fa-skull"></i> {{localize "ISUN.Dead"}}
      </span>
    {{/if}}
  </div>

  <div class="health-row anguish-row">
    <label>{{localize "ISUN.Anguish"}}</label>
    <div class="health-pips">
      {{#times (subtract system.status.anguish.max system.status.anguish.value)}}
        <span class="anguish-pip empty" {{#if @root.isGM}}data-action="add-anguish"{{/if}}></span>
      {{/times}}
      {{#times system.status.anguish.value}}
        <span class="anguish-pip full" {{#if @root.isGM}}data-action="remove-anguish"{{/if}}></span>
      {{/times}}
    </div>
    {{#if system.status.broken}}
      <span class="health-flag broken" title="{{localize 'ISUN.BrokenHint'}}">
        <i class="fa-solid fa-brain"></i> {{localize "ISUN.Broken"}}
      </span>
    {{/if}}
  </div>

  {{!-- One shared Injury track. Each pip records where it came from, because
        the pip that fills the track decides whether the set becomes a Wound or
        an Anguish. --}}
  <div class="injuries-row">
    <label>{{localize "ISUN.Injuries"}}</label>
    <div class="injury-track">
      {{#each system.status.injuries as |source i|}}
        <span class="injury-pip full {{source}}" data-action="remove-injury" data-index="{{i}}"
              title="{{localize (concat "ISUN.Injury" (capitalize source))}}"></span>
      {{/each}}
      {{#times (subtract system.status.injuryProgress.threshold system.status.injuryProgress.count)}}
        <span class="injury-pip empty"></span>
      {{/times}}
      <span class="injury-add">
        <a data-action="add-injury" data-source="physical" title="{{localize 'ISUN.AddPhysicalInjury'}}">
          <i class="fa-solid fa-droplet"></i>
        </a>
        <a data-action="add-injury" data-source="mental" title="{{localize 'ISUN.AddMentalInjury'}}">
          <i class="fa-solid fa-brain"></i>
        </a>
      </span>
    </div>
  </div>
  <p class="hint injury-hint">{{localize "ISUN.InjuryTrackHint"}}</p>

  {{!-- Four rests a day: two costing an action, one of ten minutes, one of an
        hour. Each resets a pool; the two longer ones may instead recover a
        Wound or an Anguish. --}}
  <div class="rests-row">
    <label>{{localize "ISUN.Rests"}}</label>
    <div class="rest-track">
      {{#each restRows as |r|}}
        <span class="rest-group" title="{{localize r.label}}">
          {{#times r.left}}<span class="rest-pip full"></span>{{/times}}
          {{#times (subtract r.max r.left)}}<span class="rest-pip spent"></span>{{/times}}
          <span class="rest-label">{{localize r.label}}</span>
        </span>
      {{/each}}
    </div>
  </div>
  <div class="rest-actions">
    <a data-action="apply-damage" title="{{localize 'ISUN.ApplyDamageHint'}}">
      <i class="fa-solid fa-burst"></i> {{localize "ISUN.ApplyDamage"}}
    </a>
    <a data-action="rest-recover" data-kind="wounds"
       class="{{#unless canRestHeal}}disabled{{/unless}}"
       title="{{localize 'ISUN.RestHealHint'}}">{{localize "ISUN.HealWound"}}</a>
    <a data-action="rest-recover" data-kind="anguish"
       class="{{#unless canRestHeal}}disabled{{/unless}}"
       title="{{localize 'ISUN.RestHealHint'}}">{{localize "ISUN.HealAnguish"}}</a>
    <a data-action="new-day" title="{{localize 'ISUN.NewDayHint'}}">
      <i class="fa-solid fa-bed"></i> {{localize "ISUN.NewDay"}}
    </a>
  </div>

  <div class="defenses-row">
    <div class="defense-group">
      <label>{{localize "ISUN.Armor"}}</label>
      <input type="number" name="system.status.armor" value="{{system.status.armor}}" min="0" />
    </div>
    <div class="defense-group">
      <label>{{localize "ISUN.Ward"}}</label>
      <input type="number" name="system.status.ward" value="{{system.status.ward}}" min="0" />
    </div>
  </div>
</div>
