source/books/
source/cards/
source/*.zip
# Verbatim book text pulled out for an extraction run. Copyrighted, like the
# PDFs it came from — the extracted *data* is what belongs in the repo.
source/extracted.txt
source/*.txt
trash/
node_modules/

# Card faces cut out of the deck PDFs by scripts/extract_card_images.py. They
# belong under Foundry's data folder, not in here — but ISUN_ASSETS can point
# anywhere, and a path that lands inside the repository would otherwise put
# Monte Cook Games artwork into a commit. Ignored wherever it appears.
assets/
cards/*/*.jpg
cards/*/index.json

# The compendia, at both stages. packs/_source used to be tracked, on the
# reasoning that the JSON it holds is worth reviewing — but what it holds is
# Monte Cook Games' text, extracted from books you own, and reviewable is not
# the same as distributable. It is generated on your machine by
# scripts/build_compendia.js and stays there; scripts/data.mjs is what keeps
# it safe now that git does not.
packs/

# The extracted game data, and the reference dump the extractors read. Same
# reasoning: this is the book text itself, one stage before the compendia.
source/data/
source/forte-trees/
source/isdata_2026.json

# The quirks list, written from your own copy by scripts/build_quirks.py. The
# stub that ships beside it is tracked and must stay empty.
module/helpers/quirks.local.mjs

__pycache__/

# Built by scripts/dist.mjs. The archive is assembled from the manifest and
# the compiled packs, neither of which is worth versioning.
dist/

# Data backups written by scripts/data.mjs. They belong outside the repository
# and default to ~/invisible-sun-backups, but ISUN_BACKUP_DIR can point
# anywhere — and an archive landing in here would commit the very MCG text and
# artwork the backups exist to hold. Ignored wherever it appears.
*.tar.gz
invisible-sun-backups/
