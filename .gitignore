source/books/
source/cards/
source/*.zip
# Verbatim book text pulled out for an extraction run. Copyrighted, like the
# PDFs it came from — the extracted *data* is what belongs in the repo.
source/extracted.txt
source/*.txt
trash/
node_modules/

# Compendia are compiled from packs/_source by scripts/compile_packs.js.
# The LevelDB output is a binary build artifact that rewrites itself whenever
# Foundry runs; the JSON it is built from is worth reviewing, so keep that.
packs/*
!packs/_source/
__pycache__/

# Built by scripts/dist.mjs. The archive is assembled from the manifest and
# the compiled packs, neither of which is worth versioning.
dist/
