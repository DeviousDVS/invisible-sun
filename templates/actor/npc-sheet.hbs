{{!-- An NPC carries the same printed stat block as a creature — The Nightside
      and The Path lay theirs out exactly as Teratology does — so the two sheets
      differ only in the prose beneath it: an NPC has notes the players do not
      see, and no separate combat box. --}}
<div class="{{cssClass}} flexcol" autocomplete="off">
  {{> "systems/invisible-sun/templates/partials/header-bar.hbs"}}

  <section class="sheet-body single-page npc-sheet-body">
    {{> "systems/invisible-sun/templates/partials/non-player-health.hbs"}}
    {{> "systems/invisible-sun/templates/partials/stat-block.hbs"}}

    <div class="prose-section">
      <h3>{{localize "ISUN.EntryDescription"}}</h3>
      {{isunEditor "system.description"}}
    </div>

    {{#if isGM}}
      <div class="prose-section gm-only gm-jottings">
        <h3><i class="fa-solid fa-eye-slash"></i> {{localize "ISUN.GMNotes"}}</h3>
        {{isunEditor "system.notes"}}
      </div>
    {{/if}}

    {{> "systems/invisible-sun/templates/partials/entry-source.hbs"}}
  </section>
</div>
