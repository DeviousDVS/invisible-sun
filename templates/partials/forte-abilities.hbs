<div class="forte-abilities-list item-list">
  <div class="list-header">
    <span class="level">Lvl</span>
    <span class="name">Forte Ability</span>
    <span class="depletion">Depletion</span>
    <span class="actions">
      <a class="item-create" data-type="ForteAbility" title="Create Ability"><i class="fa-solid fa-plus"></i></a>
    </span>
  </div>
  
  {{#each forteAbilities as |item|}}
    <div class="item" data-item-id="{{item.id}}">
      <div class="level"><span class="level-badge">{{item.system.level}}</span></div>
      <div class="name rollable" data-action="use-ability">
        <span class="color-badge {{colorClass item.system.color}}" title="{{item.system.color}}"></span>
        <span>{{item.name}}</span>
      </div>
      <div class="depletion">{{item.system.depletion}}</div>
      <div class="actions">
        <a class="btn-use" data-action="use-ability" title="Use"><i class="fa-solid fa-bolt"></i></a>
        <a class="item-edit" title="Edit"><i class="fa-solid fa-edit"></i></a>
        <a class="item-delete" title="Delete"><i class="fa-solid fa-trash"></i></a>
      </div>
    </div>
  {{/each}}
</div>
