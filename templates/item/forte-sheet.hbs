<div class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" data-action="editImage" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Forte Name"/></h1>
    </div>
  </header>

  <section class="sheet-body item-sheet-body">
    <div class="item-description">
      <h3>Description</h3>
      {{isunEditor "system.description"}}
    </div>
    
    <div class="item-description">
      <h3>Background</h3>
      {{isunEditor "system.background"}}
    </div>
    
    <div class="item-description">
      <h3>Appearance</h3>
      {{isunEditor "system.appearance"}}
    </div>
    
    <div class="item-description">
      <h3>Path to Joy</h3>
      {{isunEditor "system.pathToJoy"}}
    </div>
    
    <div class="item-description">
      <h3>Path to Despair</h3>
      {{isunEditor "system.pathToDespair"}}
    </div>
  </section>
</div>
