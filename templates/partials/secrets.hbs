{{!-- Character, order and apostate secrets. They are standing permissions
      rather than things you cast — "ways to do things you shouldn't be able to
      do normally" — but they are consulted mid-cast, so they sit with the
      practices they modify. House secrets are augments and live with the
      House. --}}
<div class="isun-panel secrets-strip mt-4">
  <div class="entry-list-header">
    <h3>{{localize "ISUN.Secrets"}}</h3>
    <a class="item-create" data-type="Secret" data-preset='{"secretType":"character"}'
       title="{{localize 'ISUN.AddSecret'}}"><i class="fa-solid fa-plus"></i></a>
  </div>
  <div class="secret-chips">
    {{#each characterSecrets as |s|}}
      <span class="secret-chip {{s.system.secretType}}" data-item-id="{{s.id}}">
        <a data-action="open-item" data-item-id="{{s.id}}">{{s.name}}</a>
        <a class="item-delete" title="{{localize 'ISUN.Remove'}}"><i class="fa-solid fa-xmark"></i></a>
      </span>
    {{else}}
      <span class="empty-state">{{localize "ISUN.NoSecrets"}}</span>
    {{/each}}
  </div>
</div>
