{{!-- What a Maker has on the bench.
      Only a Maker has one, so `bench` is null for every other order and this
      whole block is absent rather than empty — the same rule the Vance's mind
      follows a few sections up. Null too when the bench is clear, which is the
      commoner case: the panel appears when there is work and goes when the work
      is done, rather than standing about as an empty workshop.

      A Maker between commissions gets the panel with nothing in it but the way
      to begin one; taking the next step arrives with the runner. --}}
{{#if isMaker}}
<div class="makers-bench{{#if bench.finished}} finished{{/if}}{{#unless bench}} clear{{/unless}}">

  <div class="bench-head">
    <h3>{{localize "ISUN.BenchTitle"}}</h3>
    {{#if bench}}
      <span class="bench-what">
        <span class="bench-effect">{{bench.effect}}</span>
        <span class="bench-level">{{localize "ISUN.BenchLevelN" level=bench.level}}</span>
      </span>
    {{else}}
      <a class="bench-begin" data-action="making-begin">
        <i class="fa-solid fa-hammer"></i> {{localize "ISUN.BenchBegin"}}
      </a>
    {{/if}}
  </div>

  {{#if bench}}

  {{!-- How far the working level has climbed towards what it is aiming at. Not
        a share of the days: the process is a ladder of challenges, and the rung
        it is on is what a Maker is actually counting. --}}
  <div class="bench-progress">
    <span class="bench-bar" data-tooltip="{{localize 'ISUN.BenchBarHint'
            x=bench.x target=bench.target}}">
      <span class="bench-fill" style="width: {{bench.percent}}%"></span>
    </span>
    <span class="bench-count">{{bench.x}} / {{bench.target}}</span>
  </div>

  {{!-- Where the process is resting, which is the first thing somebody picking
        the work up again needs to be told. --}}
  <div class="bench-step">
    <span class="bench-node">{{localize bench.stepLabel}}</span>
    {{#if bench.challenge}}
      <span class="bench-challenge" data-tooltip="{{localize 'ISUN.BenchChallengeHint'}}">
        {{localize "ISUN.BenchChallengeN" n=bench.challenge}}
      </span>
    {{/if}}
    {{#if bench.componentLevel}}
      <span class="bench-component" data-tooltip="{{localize 'ISUN.BenchComponentHint'}}">
        {{localize "ISUN.BenchComponentN" level=bench.componentLevel}}
      </span>
    {{/if}}
  </div>

  {{!-- What the work has cost so far. The Sorcery is held rather than spent:
        it comes back when the work ends, however it ends. --}}
  <ul class="bench-costs">
    <li data-tooltip="{{localize 'ISUN.BenchSorceryHint'}}">
      <span class="cost-n">{{bench.sorceryHeld}}</span> {{localize "ISUN.BenchSorceryHeld"}}
    </li>
    <li data-tooltip="{{localize 'ISUN.BenchDaysHint'}}">
      <span class="cost-n">{{bench.onBench}} / {{bench.days}}</span> {{localize "ISUN.BenchDays"}}
    </li>
    {{#if bench.failures}}
      <li class="bad"><span class="cost-n">{{bench.failures}}</span> {{localize "ISUN.BenchFailures"}}</li>
    {{/if}}
    {{#if bench.sideEffects.length}}
      {{!-- What the flaws are, not only how many: the count says the item is
            worth less and the tooltip says what is wrong with it. --}}
      <li class="bad" data-tooltip="{{localize 'ISUN.BenchFlawsHint'}}{{#if bench.flawText}} — {{bench.flawText}}{{/if}}">
        <span class="cost-n">{{bench.sideEffects.length}}</span> {{localize bench.flawsLabel}}
      </li>
    {{/if}}
  </ul>

  {{!-- What a finished work came to, where a table said it: the mishap, or the
        effect of an item nobody chose. Rolled once when the process ended, so
        this and the chat card say the same thing however often it is read. --}}
  {{#if bench.outcome}}
    <p class="bench-outcome">
      <span class="bench-outcome-label">{{localize "ISUN.BenchOutcome"}}</span>
      {{bench.outcome}}
    </p>
  {{/if}}

  {{!-- Quitting is the Maker's right at any point in the process. What they get
        for it depends on where they stopped, and the Matrix decides that — so
        this clears the bench and gives the Sorcery back, and nothing else. --}}
  <div class="bench-actions">
    {{!-- One press, one box of the chart. A finished work has nothing left to
          do, so it offers to say again how it ended instead. --}}
    <a class="bench-work-on" data-action="making-continue">
      <i class="fa-solid fa-hammer"></i>
      {{#if bench.finished}}{{localize "ISUN.BenchSayAgain"}}{{else}}{{localize "ISUN.BenchWorkOn"}}{{/if}}
    </a>
    <a class="bench-abandon" data-action="making-abandon"
       data-tooltip="{{localize 'ISUN.BenchAbandonHint'}}">
      <i class="fa-solid fa-xmark"></i> {{localize "ISUN.BenchAbandon"}}
    </a>
  </div>
  {{else}}
    {{!-- A Maker between commissions. Said rather than left blank: an empty
          bench and a bench that failed to render look the same otherwise. --}}
    <p class="hint bench-clear">{{localize "ISUN.BenchClear"}}</p>
  {{/if}}
</div>
{{/if}}
