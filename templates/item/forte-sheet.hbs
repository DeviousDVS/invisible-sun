<div class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Forte Name"/></h1>
    </div>
  </header>

  <section class="sheet-body item-sheet-body">
    <div class="item-description">
      <h3>Description</h3>
      {{editor system.description target="system.description" button=true owner=owner editable=editable}}
    </div>
    
    <div class="item-description">
      <h3>Background</h3>
      {{editor system.background target="system.background" button=true owner=owner editable=editable}}
    </div>
    
    <div class="item-description">
      <h3>Appearance</h3>
      {{editor system.appearance target="system.appearance" button=true owner=owner editable=editable}}
    </div>
    
    <div class="item-description">
      <h3>Path to Joy</h3>
      {{editor system.pathToJoy target="system.pathToJoy" button=true owner=owner editable=editable}}
    </div>
    
    <div class="item-description">
      <h3>Path to Despair</h3>
      {{editor system.pathToDespair target="system.pathToDespair" button=true owner=owner editable=editable}}
    </div>
  </section>
</div>
