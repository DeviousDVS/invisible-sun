<div class="{{cssClass}} flexcol" autocomplete="off">
  {{> "systems/invisible-sun/templates/partials/header-bar.hbs"}}

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="overview">{{localize "ISUN.TabOverview"}}</a>
    <a class="item" data-tab="stats">{{localize "ISUN.TabStats"}}</a>
    <a class="item" data-tab="magic">{{localize "ISUN.TabMagic"}}</a>
    <a class="item" data-tab="identity">{{localize "ISUN.TabIdentity"}}</a>
    <a class="item" data-tab="arcs">{{localize "ISUN.TabArcs"}}</a>
    <a class="item" data-tab="inventory">{{localize "ISUN.TabInventory"}}</a>
    <a class="item" data-tab="biography">{{localize "ISUN.TabBiography"}}</a>
  </nav>

  <section class="sheet-body">
    
    {{!-- Overview Tab --}}
    <div class="tab overview" data-group="primary" data-tab="overview">
      <div class="character-sentence-banner">
        <span>{{localize "ISUN.CharacterSentence" foundation=(concat "<span class='sentence-part foundation'>" characterSentence.foundation "</span>") heart=(concat "<span class='sentence-part heart'>" characterSentence.heart "</span>") order=(concat "<span class='sentence-part order'>" characterSentence.order "</span>") forte=(concat "<span class='sentence-part forte'>" characterSentence.forte "</span>")}}</span>
      </div>
      
      <div class="overview-grid">
        <div class="overview-health">
          {{> "systems/invisible-sun/templates/partials/wound-tracker.hbs"}}
        </div>
        
        <div class="overview-advancement">
          <h3>Advancement</h3>
          <div class="advancement-bar">
            <div class="adv-item joy"><i class="fa-solid fa-sun"></i> <span>{{system.advancement.joy}}</span></div>
            <div class="adv-item despair"><i class="fa-solid fa-moon"></i> <span>{{system.advancement.despair}}</span></div>
            <div class="adv-item acumen"><i class="fa-solid fa-graduation-cap"></i> <span>{{system.advancement.acumen}}</span></div>
            <div class="adv-item crux"><i class="fa-solid fa-star"></i> <span>{{system.advancement.crux}}</span></div>
          </div>
        </div>
      </div>
    </div>

    {{!-- Stats & Pools Tab --}}
    <div class="tab stats" data-group="primary" data-tab="stats">
      {{> "systems/invisible-sun/templates/partials/stat-pool.hbs"}}
    </div>

    {{!-- Magic Tab --}}
    <div class="tab magic" data-group="primary" data-tab="magic">
      {{> "systems/invisible-sun/templates/partials/spell-list.hbs"}}
      {{> "systems/invisible-sun/templates/partials/forte-abilities.hbs"}}
    </div>

    {{!-- Identity Tab --}}
    <div class="tab identity" data-group="primary" data-tab="identity">
      <div class="identity-cards">
        <!-- Render Hearts, Orders, Fortes, Souls attached to actor -->
      </div>
    </div>

    {{!-- Arcs Tab --}}
    <div class="tab arcs" data-group="primary" data-tab="arcs">
      {{> "systems/invisible-sun/templates/partials/character-arc-tracker.hbs"}}
    </div>

    {{!-- Inventory Tab --}}
    <div class="tab inventory" data-group="primary" data-tab="inventory">
      {{> "systems/invisible-sun/templates/partials/inventory-list.hbs"}}
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="biography">
      {{editor system.biography target="system.biography" button=true owner=owner editable=editable}}
    </div>

  </section>
</div>
