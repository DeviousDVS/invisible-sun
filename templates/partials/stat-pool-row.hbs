<div class="pool-row" data-pool="{{poolName}}">
  <div class="pool-label">
    {{localize label}}
    {{#if pool.scourgeTotal}}
      <span class="scourge-mark" title="{{localize 'ISUN.ScourgeHint'}}">−{{pool.scourgeTotal}}</span>
    {{/if}}
  </div>
  
  <div class="pool-pips">
    {{#times (poolRemaining pool)}}
      <span class="{{#if pipClass}}{{pipClass}}{{else}}bene-pip{{/if}} empty"></span>
    {{/times}}
    {{#times pool.value}}
      <span class="{{#if pipClass}}{{pipClass}}{{else}}bene-pip{{/if}} full"
            data-action="spend-bene" data-pool="{{poolName}}" title="{{localize 'ISUN.Spend'}}"></span>
    {{/times}}
  </div>
  
  {{#if pool.vex}}
    <span class="vex-group" title="{{localize 'ISUN.VexHint'}}">
      {{#times pool.vex}}<span class="vex-pip"></span>{{/times}}
    </span>
  {{/if}}

  {{!-- Placing points. Minus shows whenever a pool has something to give
        back, so a player can always reallocate; plus only while points remain
        to place, so the budget cannot be overspent. --}}
  {{#if showAllocation}}
    <div class="pool-alloc">
      <a class="alloc-btn minus{{#unless pool.max}} disabled{{/unless}}"
         data-action="alloc-pool" data-delta="-1" data-pool="{{poolName}}"
         data-stat="{{statKey}}" data-tooltip="{{localize 'ISUN.AllocTakeBack'}}">−</a>
      <a class="alloc-btn plus{{#unless unspentPoints}} disabled{{/unless}}"
         data-action="alloc-pool" data-delta="1" data-pool="{{poolName}}"
         data-stat="{{statKey}}" data-tooltip="{{localize 'ISUN.AllocPlace'}}">+</a>
    </div>
  {{/if}}

  <div class="pool-inputs">
    <input type="number" name="system.stats.{{statKey}}.pools.{{poolName}}.value" value="{{pool.value}}" />
    <span>/</span>
    <input type="number" name="system.stats.{{statKey}}.pools.{{poolName}}.max" value="{{pool.max}}" />
  </div>
  
  <div class="pool-actions">
    <a class="btn-refresh" data-action="refresh-pool" data-pool="{{poolName}}" title="{{localize 'ISUN.Refresh'}}">
      <i class="fa-solid fa-arrows-rotate"></i>
    </a>
  </div>
</div>
