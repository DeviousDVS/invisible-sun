<div class="{{cssClass}} flexcol" autocomplete="off">
  {{> "systems/invisible-sun/templates/partials/header-bar.hbs"}}

  <nav class="sheet-tabs tabs" data-group="primary">
    {{#each tabs as |tab|}}
      <a class="item {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">{{localize tab.label}}</a>
    {{/each}}
  </nav>

  <section class="sheet-body">
    
    {{!-- Overview Tab --}}
    <div class="tab overview {{tabs.overview.cssClass}}" data-group="primary" data-tab="overview">
      <div class="character-sentence-banner">
        <span>{{{characterSentenceHTML}}}</span>
      </div>
      
      {{> "systems/invisible-sun/templates/partials/stat-pool.hbs"}}

      {{!-- Skills sit under the pools: both feed a venture, and a player
            deciding a roll wants to see them together. --}}
      {{> "systems/invisible-sun/templates/partials/skill-list.hbs"}}

      <div class="overview-grid mt-4">
        <div class="overview-health">
          {{> "systems/invisible-sun/templates/partials/wound-tracker.hbs"}}
        </div>
        
        <div class="overview-advancement">
          <h3>{{localize "ISUN.Advancement"}}</h3>

          {{!-- Four things that are earned and kept. Each is labelled and says
                where it comes from on hover, because a sun and a moon side by
                side do not tell anyone which is Joy. --}}
          {{!-- Name, value, icon — in that order and in fixed columns, so the
                four numbers form a line the eye can run down. The adjust
                controls sit between value and icon and reserve their space
                whether shown or not, or the icons would jump on hover. --}}
          <div class="advancement-bar">
            {{#each advancement as |a|}}
              <div class="adv-item {{a.key}}" data-tooltip="{{localize a.hint}}">
                <span class="adv-label">{{localize a.label}}</span>
                <span class="adv-value">{{a.value}}</span>
                <span class="adv-adjust">
                  <a data-action="adv-adjust" data-key="{{a.key}}" data-delta="1"
                     data-tooltip="{{localize 'ISUN.AdvGain'}}">+</a>
                  <a data-action="adv-adjust" data-key="{{a.key}}" data-delta="-1"
                     data-tooltip="{{localize 'ISUN.AdvSpend'}}">−</a>
                </span>
                <i class="fa-solid {{a.icon}}"></i>
              </div>
            {{/each}}
          </div>

          {{!-- Crux is not one of them. It is what a Joy and a Despair are
                worth together, and it comes into existence only when something
                is bought — so this is a rate, not a holding. Uneven pools are
                worth saying out loud: knowing you have the Joy but not the
                Despair is what tells a player which path to walk next. --}}
          <div class="crux-readout{{#unless crux}} empty{{/unless}}"
               data-tooltip="{{localize 'ISUN.CruxHint'}}">
            <span class="crux-label">{{localize "ISUN.CruxAvailable"}}</span>
            <span class="crux-value">{{crux}}</span>
            <i class="fa-solid fa-star"></i>
            {{#if cruxShortOf}}
              <span class="crux-limit">{{localize "ISUN.CruxShortOf"}} {{cruxShortOf}}</span>
            {{/if}}
          </div>

          {{!-- Degree sits with advancement: it is bought with Crux. --}}
          <div class="form-group mt-4">
            <label>{{localize "ISUN.OrderDegree"}}</label>
            {{!-- The number is the character's; the name for it belongs to
                  the order and is read from there. --}}
            <div class="degree-picker">
              <select name="system.meta.orderDegree">
                <option value="0" {{#if (eq system.meta.orderDegree 0)}}selected{{/if}}>—</option>
                {{#each degreeLadder as |d|}}
                  <option value="{{d.degree}}" {{#if d.current}}selected{{/if}}>{{d.degree}}</option>
                {{/each}}
              </select>
              <span class="degree-title">{{orderDegreeTitle}}</span>
            </div>
          </div>
        </div>
      </div>
    </div>


    {{!-- Magic Tab --}}
    <div class="tab magic {{tabs.magic.cssClass}}" data-group="primary" data-tab="magic">
      {{> "systems/invisible-sun/templates/partials/order.hbs"}}
      {{> "systems/invisible-sun/templates/partials/practices.hbs"}}
      {{> "systems/invisible-sun/templates/partials/secrets.hbs"}}
    </div>



    {{!-- Connections Tab --}}
    <div class="tab connections {{tabs.connections.cssClass}}" data-group="primary" data-tab="connections">
      {{> "systems/invisible-sun/templates/partials/connections.hbs"}}
    </div>

    {{!-- Arcs Tab --}}
    <div class="tab arcs {{tabs.arcs.cssClass}}" data-group="primary" data-tab="arcs">
      {{> "systems/invisible-sun/templates/partials/character-arc-tracker.hbs"}}
    </div>

    {{!-- Inventory Tab --}}
    <div class="tab inventory {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">
      {{> "systems/invisible-sun/templates/partials/inventory-list.hbs"}}
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography {{tabs.biography.cssClass}}" data-group="primary" data-tab="biography">
      {{> "systems/invisible-sun/templates/partials/narrative.hbs"}}
    </div>

  </section>
</div>
