<div class="inventory-container">
  
  <div class="inventory-section">
    <h3>Ephemera</h3>
    <div class="item-list">
      <div class="list-header">
        <span class="level">Lvl</span>
        <span class="name">Item</span>
        <span class="type">Type</span>
        <span class="actions">
          <a class="item-create" data-type="Ephemera"><i class="fa-solid fa-plus"></i></a>
        </span>
      </div>
      {{#each ephemera as |item|}}
        <div class="item" data-item-id="{{item.id}}">
          <div class="level">{{item.system.level}}</div>
          <div class="name">
            <span class="color-badge {{colorClass item.system.color}}"></span>
            {{item.name}}
          </div>
          <div class="type">{{item.system.ephemeraType}}</div>
          <div class="actions">
            <a class="item-edit"><i class="fa-solid fa-edit"></i></a>
            <a class="item-delete"><i class="fa-solid fa-trash"></i></a>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="inventory-section mt-4">
    <h3>Objects of Power</h3>
    <div class="item-list">
      <div class="list-header">
        <span class="level">Lvl</span>
        <span class="name">Object</span>
        <span class="depletion">Depletion</span>
        <span class="actions">
          <a class="item-create" data-type="ObjectOfPower"><i class="fa-solid fa-plus"></i></a>
        </span>
      </div>
      {{#each objectsOfPower as |item|}}
        <div class="item" data-item-id="{{item.id}}">
          <div class="level">{{item.system.level}}</div>
          <div class="name">{{item.name}}</div>
          <div class="depletion">{{item.system.depletion}}</div>
          <div class="actions">
            <a class="item-edit"><i class="fa-solid fa-edit"></i></a>
            <a class="item-delete"><i class="fa-solid fa-trash"></i></a>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="economy-section mt-4">
    <h3>Economy</h3>
    <div class="economy-grid">
      <div class="economy-field">
        <label>Savings (Orbs)</label>
        <input type="number" name="system.economy.savings" value="{{system.economy.savings}}" />
      </div>
      <div class="economy-field">
        <label>Weekly Income</label>
        <input type="number" name="system.economy.income" value="{{system.economy.income}}" />
      </div>
      <div class="economy-field full-width">
        <label>Debts</label>
        <input type="text" name="system.economy.debts" value="{{system.economy.debts}}" />
      </div>
    </div>
  </div>

  <div class="house-section mt-4">
    <h3>House</h3>
    <div class="house-grid">
      <div class="house-field">
        <label>Level</label>
        <input type="number" name="system.house.level" value="{{system.house.level}}" />
      </div>
      <div class="house-field">
        <label>Type</label>
        <input type="text" name="system.house.type" value="{{system.house.type}}" />
      </div>
      <div class="house-field full-width">
        <label>Augments</label>
        <input type="text" name="system.house.augments" value="{{system.house.augments}}" />
      </div>
    </div>
  </div>

</div>
